+export async function adjustFinanceBookingBalance(actor: FinanceActor, input: any) {
+  await assertFinanceRole(actor, ["Owner", "FinanceManager", "Accountant"]);
+  const db = requireDb(await getDb());
+  const bookingId = Number(input.bookingId);
+  const targetCollected = new Decimal(normalizeMoney(input.collectedAmount, "المبلغ المحصل"));
+  const targetRemaining = new Decimal(normalizeMoney(input.remainingAmount, "المبلغ المتبقي"));
+  const reason = cleanText(input.reason, 1000, true)!;
+
+  return db.transaction(async (tx: any) => {
+    const booking = first<any>(await tx.execute(sql`
+      SELECT id, bookingNumber, status, netAmount
+      FROM finance_bookings
+      WHERE id=${bookingId} AND deletedAt IS NULL
+      FOR UPDATE
+    `));
+    if (!booking) throw new TRPCError({ code: "NOT_FOUND", message: "الحجز غير موجود" });
+    if (booking.status !== "Confirmed") {
+      throw new TRPCError({ code: "CONFLICT", message: "يمكن تعديل المحصل والمتبقي للحجز المعتمد فقط" });
+    }
+
+    const totals = first<any>(await tx.execute(sql`
+      SELECT
+        COALESCE((SELECT SUM(amount) FROM finance_collections
+                  WHERE bookingId=${bookingId} AND deletedAt IS NULL),0) AS paid,
+        COALESCE((SELECT SUM(amount + cancellationFee) FROM finance_refunds
+                  WHERE bookingId=${bookingId} AND status='Approved'),0) AS allocatedRefunds,
+        COALESCE((SELECT COUNT(*) FROM finance_refunds
+                  WHERE bookingId=${bookingId}
+                    AND status IN ('PendingFinanceManager','PendingOwner')),0) AS pendingRefunds
+    `));
+    if (Number(totals?.pendingRefunds ?? 0) > 0) {
+      throw new TRPCError({ code: "CONFLICT", message: "لا يمكن تعديل الرصيد أثناء وجود طلب استرداد قيد الاعتماد" });
+    }
+
+    const netAmount = new Decimal(booking.netAmount ?? 0).toDecimalPlaces(2);
+    if (!targetCollected.plus(targetRemaining).equals(netAmount)) {
+      throw new TRPCError({
+        code: "BAD_REQUEST",
+        message: "المبلغ المحصل + المبلغ المتبقي يجب أن يساويا صافي قيمة الحجز",
+      });
+    }
+    if (targetCollected.greaterThan(netAmount)) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: "المبلغ المحصل لا يمكن أن يتجاوز صافي الحجز" });
+    }
+
+    const allocatedRefunds = new Decimal(totals?.allocatedRefunds ?? 0);
+    if (targetCollected.lessThan(allocatedRefunds)) {
+      throw new TRPCError({
+        code: "BAD_REQUEST",
+        message: "لا يمكن خفض المحصل لأقل من قيمة الاستردادات المعتمدة المرتبطة بالحجز",
+      });
+    }
+
+    const currentCollected = new Decimal(totals?.paid ?? 0).toDecimalPlaces(2);
+    const delta = targetCollected.minus(currentCollected).toDecimalPlaces(2, Decimal.ROUND_HALF_UP);
+    if (delta.isZero()) {
+      return {
+        success: true,
+        adjusted: false,
+        collectedAmount: targetCollected.toFixed(2),
+        remainingAmount: targetRemaining.toFixed(2),
+      };
+    }
+
+    await tx.execute(sql`
+      INSERT INTO finance_payment_methods (name, isActive, sortOrder)
+      VALUES ('تسوية رصيد', 1, 990)
+      ON DUPLICATE KEY UPDATE isActive=1, sortOrder=VALUES(sortOrder), updatedAt=NOW()
+    `);
+    const adjustmentMethod = first<any>(await tx.execute(sql`
+      SELECT id FROM finance_payment_methods WHERE name='تسوية رصيد' LIMIT 1
+    `));
+    if (!adjustmentMethod?.id) {
+      throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "تعذر تجهيز طريقة تسوية الرصيد" });
+    }
+
+    const adjustmentNote = cleanText(`تسوية رصيد يدوية: ${reason}`, 2000, true)!;
+    const result = await tx.execute(sql`
+      INSERT INTO finance_collections
+        (bookingId, amount, paymentMethodId, paymentDate, notes, createdBy)
+      VALUES
+        (${bookingId}, ${delta.toFixed(2)}, ${Number(adjustmentMethod.id)}, CURRENT_DATE, ${adjustmentNote}, ${actor.id})
+    `);
+    const adjustmentId = insertId(result);
+
+    await writeFinanceAudit(
+      tx,
+      actor,
+      "FINANCE_BOOKING_BALANCE_ADJUSTED",
+      "finance_booking",
+      bookingId,
+      booking.bookingNumber,
+      { reason, adjustmentId, delta: delta.toFixed(2) },
+      {
+        collectedAmount: currentCollected.toFixed(2),
+        remainingAmount: Decimal.max(netAmount.minus(currentCollected), 0).toFixed(2),
+      },
+      {
+        collectedAmount: targetCollected.toFixed(2),
+        remainingAmount: targetRemaining.toFixed(2),
+      },
+    );
+
+    return {
+      success: true,
+      adjusted: true,
+      adjustmentId,
+      delta: delta.toFixed(2),
+      collectedAmount: targetCollected.toFixed(2),
+      remainingAmount: targetRemaining.toFixed(2),
+    };
+  });
+}
