+++ b/scripts/apply-finance-client-booking-v1-migration.ts
@@ -0,0 +1,68 @@
+import "dotenv/config";
+import { sql } from "drizzle-orm";
+import { getDb } from "../server/db";
+
+const APPLY = process.argv.includes("--apply");
+
+const services = [
+  ["عمرة", 1],
+  ["حج قرعة", 10],
+  ["حج مباشر", 20],
+  ["تأشيرة سياحية", 30],
+  ["حجز تذكرة طيران", 40],
+  ["حجز فندق", 50],
+  ["خدمات النقل", 60],
+] as const;
+
+async function main() {
+  const db = await getDb();
+  if (!db) throw new Error("DATABASE_URL is not configured or database is unavailable");
+
+  if (!APPLY) {
+    console.log("DRY_RUN finance_client_booking_v1");
+    console.log("Would seed 7 requested booking services and the balance-adjustment payment method.");
+    console.log("Default service in the UI will be عمرة.");
+    console.log("Re-run with --apply to execute.");
+    return;
+  }
+
+  for (const [name, sortOrder] of services) {
+    await db.execute(sql`
+      INSERT INTO finance_services (name, isActive, sortOrder)
+      VALUES (${name}, 1, ${sortOrder})
+      ON DUPLICATE KEY UPDATE isActive=1, sortOrder=VALUES(sortOrder), updatedAt=NOW()
+    `);
+  }
+
+  await db.execute(sql`
+    INSERT INTO finance_payment_methods (name, isActive, sortOrder)
+    VALUES ('تسوية رصيد', 1, 990)
+    ON DUPLICATE KEY UPDATE isActive=1, sortOrder=VALUES(sortOrder), updatedAt=NOW()
+  `);
+
+  const verification = await db.execute(sql`
+    SELECT name
+    FROM finance_services
+    WHERE isActive=1 AND name IN
+      ('عمرة','حج قرعة','حج مباشر','تأشيرة سياحية','حجز تذكرة طيران','حجز فندق','خدمات النقل')
+  `);
+  const foundServices = new Set((((verification as any)[0] ?? []) as any[]).map((row) => String(row.name)));
+  const missing = services.map(([name]) => name).filter((name) => !foundServices.has(name));
+  if (missing.length) throw new Error(`Missing finance services after migration: ${missing.join(", ")}`);
+
+  const method = await db.execute(sql`
+    SELECT id FROM finance_payment_methods
+    WHERE name='تسوية رصيد' AND isActive=1
+    LIMIT 1
+  `);
+  if (!(((method as any)[0] ?? []) as any[]).length) {
+    throw new Error("Balance adjustment payment method was not created");
+  }
+
+  console.log("TTCRM_FINANCE_CLIENT_BOOKING_V1_MIGRATION_OK");
+}
+
+main().catch((error) => {
+  console.error("TTCRM_FINANCE_CLIENT_BOOKING_V1_MIGRATION_FAILED", error);
+  process.exit(1);
+});
