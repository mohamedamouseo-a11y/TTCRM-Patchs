+const SAFE_SQL_MIGRATION_PREFIX = "drizzle/migrations/";
+
 const SECRET_PATTERNS: Array<{ label: string; expression: RegExp }> = [
@@ -67,12 +69,14 @@ export function getBlockedGitPathReason(filePath: string) {
   const normalized = normalizeGitPath(filePath);
   const lower = normalized.toLowerCase();
   const base = path.posix.basename(lower);
+  const isSafeTextSqlMigration = lower.startsWith(SAFE_SQL_MIGRATION_PREFIX) && base.endsWith(".sql");
   if (!normalized || normalized.includes("\0") || normalized.startsWith("../") || normalized.includes("/../")) return "Unsafe repository path";
