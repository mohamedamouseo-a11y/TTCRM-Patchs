 let warnedSchemaUnavailable = false;
 
+function isMissingRbacSchemaError(error: unknown): boolean {
+  const queue: unknown[] = [error];
+  const seen = new Set<unknown>();
+  while (queue.length) {
+    const current = queue.shift();
+    if (!current || seen.has(current)) continue;
+    seen.add(current);
+    const value = current as any;
+    const code = String(value?.code ?? "");
+    const errno = Number(value?.errno);
+    const message = String(value?.message ?? "");
+    if (
+      code === "ER_NO_SUCH_TABLE" ||
+      errno === 1146 ||
+      (/ttcrm_rbac_/i.test(message) && /(doesn't exist|does not exist|unknown table)/i.test(message))
+    ) return true;
+    if (value?.cause) queue.push(value.cause);
+  }
+  return false;
+}
+
+function warnMigrationFallback(error: unknown) {
+  if (warnedSchemaUnavailable) return;
+  warnedSchemaUnavailable = true;
+  console.warn("[RBAC] Phase 1 schema is missing; migration fallback is active", error);
+}
+
+function failClosedRbacError(operation: string) {
+  return new TRPCError({ code: "FORBIDDEN", message: `RBAC ${operation} failed closed` });
+}
+
+function parseJsonValue(value: unknown): unknown {
+  if (value == null || typeof value === "object") return value ?? null;
+  try { return JSON.parse(String(value)); } catch { return value; }
+}
