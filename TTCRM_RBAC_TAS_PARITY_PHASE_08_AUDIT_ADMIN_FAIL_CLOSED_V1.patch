+export async function getTtcrmRbacSecurityStatus() {
+  const db = await getDb();
+  if (!db) {
+    return {
+      schemaReady: false,
+      migrationFallbackActive: true,
+      failClosedOnUnexpectedErrors: true,
+      reason: "database-unavailable" as const,
+      rolesCount: 0,
+      permissionRowsCount: 0,
+      assignmentsCount: 0,
+      auditRowsCount: 0,
+    };
+  }
+
+  try {
+    const result = await db.execute(sql`
+      SELECT
+        (SELECT COUNT(*) FROM ttcrm_rbac_roles) AS rolesCount,
+        (SELECT COUNT(*) FROM ttcrm_rbac_role_permissions) AS permissionRowsCount,
+        (SELECT COUNT(*) FROM ttcrm_rbac_user_roles WHERE is_primary = 1) AS assignmentsCount,
+        (SELECT COUNT(*) FROM ttcrm_rbac_audit_log) AS auditRowsCount
+    `);
+    const row = rowsOf(result)[0] ?? {};
+    return {
+      schemaReady: true,
+      migrationFallbackActive: false,
+      failClosedOnUnexpectedErrors: true,
+      reason: "ready" as const,
+      rolesCount: Number(row.rolesCount ?? 0),
+      permissionRowsCount: Number(row.permissionRowsCount ?? 0),
+      assignmentsCount: Number(row.assignmentsCount ?? 0),
+      auditRowsCount: Number(row.auditRowsCount ?? 0),
+    };
+  } catch (error) {
+    if (isMissingRbacSchemaError(error)) {
+      warnMigrationFallback(error);
+      return {
+        schemaReady: false,
+        migrationFallbackActive: true,
+        failClosedOnUnexpectedErrors: true,
+        reason: "rbac-schema-missing" as const,
+        rolesCount: 0,
+        permissionRowsCount: 0,
+        assignmentsCount: 0,
+        auditRowsCount: 0,
+      };
+    }
+    console.error("[RBAC] Security status check detected a schema/database error", error);
+    return {
+      schemaReady: false,
+      migrationFallbackActive: false,
+      failClosedOnUnexpectedErrors: true,
+      reason: "rbac-schema-error" as const,
+      rolesCount: 0,
+      permissionRowsCount: 0,
+      assignmentsCount: 0,
+      auditRowsCount: 0,
+    };
+  }
+}
