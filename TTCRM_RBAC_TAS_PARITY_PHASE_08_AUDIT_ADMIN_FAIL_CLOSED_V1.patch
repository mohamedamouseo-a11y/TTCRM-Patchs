+export async function listTtcrmRbacAuditLog(limit = 50) {
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database is unavailable" });
+  const safeLimit = Math.min(Math.max(Math.trunc(limit) || 50, 1), 100);
+  const result = await db.execute(sql`
+    SELECT a.id,
+           a.actor_user_id AS actorUserId,
+           u.name AS actorName,
+           u.email AS actorEmail,
+           a.action,
+           a.target_type AS targetType,
+           a.target_id AS targetId,
+           a.before_json AS beforeJson,
+           a.after_json AS afterJson,
+           a.created_at AS createdAt
+    FROM ttcrm_rbac_audit_log a
+    LEFT JOIN users u ON u.id = a.actor_user_id
+    ORDER BY a.id DESC
+    LIMIT ${safeLimit}
+  `);
+  return rowsOf(result).map((row) => ({
+    id: Number(row.id),
+    actorUserId: Number(row.actorUserId),
+    actorName: row.actorName ?? null,
+    actorEmail: row.actorEmail ?? null,
+    action: String(row.action ?? ""),
+    targetType: String(row.targetType ?? ""),
+    targetId: row.targetId == null ? null : String(row.targetId),
+    before: parseJsonValue(row.beforeJson),
+    after: parseJsonValue(row.afterJson),
+    createdAt: row.createdAt ?? null,
+  }));
+}
