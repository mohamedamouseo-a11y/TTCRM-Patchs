+// - expose myPermissions/rolePermissions/updateRolePermissions/resetRolePermissions in server/_core/systemRouter.ts
+// - make client/src/lib/roles.ts support runtime overrides
+// - hydrate permissions in client/src/_core/hooks/useAuth.ts
+// - make client/src/components/RolePermissionsStudio.tsx editable with module visibility + CRUD/manage/approve/action toggles
+// - enforce dynamic permissions in server/_core/trpc.ts
+
