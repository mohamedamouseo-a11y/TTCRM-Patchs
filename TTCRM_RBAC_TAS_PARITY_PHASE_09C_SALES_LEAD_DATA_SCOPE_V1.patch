+async function applyLeadUserScopeCondition(db: any, conditions: any[], userIds: number[]) {
+  const normalizedUserIds = [...new Set(
+    userIds.map(Number).filter((id) => Number.isInteger(id) && id > 0),
+  )];
+  if (!normalizedUserIds.length) {
+    conditions.push(sql`1 = 0`);
+    return;
+  }
+
+  const assignedRows = await db
+    .select({ leadId: leadAssignments.leadId })
+    .from(leadAssignments)
+    .where(and(
+      inArray(leadAssignments.userId, normalizedUserIds),
+      eq(leadAssignments.isActive, 1 as any),
+    ));
+  const assignedLeadIds = [...new Set(
+    assignedRows.map((row: any) => Number(row.leadId)).filter((id: number) => Number.isInteger(id) && id > 0),
+  )];
+
+  const ownerCondition = inArray(leads.ownerId, normalizedUserIds);
+  conditions.push(
+    assignedLeadIds.length
+      ? or(ownerCondition, inArray(leads.id, assignedLeadIds))!
+      : ownerCondition,
+  );
+}
