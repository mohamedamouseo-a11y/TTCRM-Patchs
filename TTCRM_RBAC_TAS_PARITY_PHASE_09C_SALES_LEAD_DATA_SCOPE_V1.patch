+
+async function resolveSalesLeadScope(ctx: any, action: "view" | "edit" | "delete") {
+  const { requireEffectiveTtcrmPermission } = await import("./services/rbacService");
+  return requireEffectiveTtcrmPermission(ctx.user, "sales", action);
+}
+
+async function applySalesLeadListScope(ctx: any, filters: any) {
+  const scope = await resolveSalesLeadScope(ctx, "view");
+  if (scope === "all") return filters;
+
+  filters.unassignedOnly = false;
+  filters.taraPendingDistributionOnly = false;
+  delete filters.assignedUserId;
+  delete filters.assignedUserIds;
+
+  if (scope === "own") {
+    filters.ownerId = ctx.user.id;
+    return filters;
+  }
+  if (scope === "assigned") {
+    delete filters.ownerId;
+    filters.assignedUserId = ctx.user.id;
+    return filters;
+  }
+
+  const { resolveTtcrmScopeUserIds } = await import("./services/rbacDataScope");
+  const userIds = await resolveTtcrmScopeUserIds(ctx.user.id, scope);
+  delete filters.ownerId;
+  filters.assignedUserIds = userIds ?? [];
+  return filters;
+}
+
+async function assertSalesLeadRecordScope(ctx: any, lead: any, action: "view" | "edit" | "delete") {
+  const scope = await resolveSalesLeadScope(ctx, action);
+  if (scope === "all") return;
+
+  const actorId = Number(ctx.user.id);
+  const ownerId = Number(lead?.ownerId ?? 0);
+  if (scope === "own") {
+    if (ownerId !== actorId) {
+      throw new TRPCError({ code: "FORBIDDEN", message: "Lead is outside own data scope" });
+    }
+    return;
+  }
+
+  const assignments = await getLeadAssignments(Number(lead.id));
+  const activeUserIds = assignments
+    .map((assignment: any) => Number(assignment.userId))
+    .filter((id: number) => Number.isInteger(id) && id > 0);
+
+  if (scope === "assigned") {
+    if (ownerId === actorId) return;
+    const access = await checkLeadAccess(Number(lead.id), actorId);
+    if (access.hasAccess && (action === "view" || access.permissions !== "view")) return;
+
+    const legacyRole = normalizeUserRole(ctx.user.role);
+    if (legacyRole === "PartsAgent") {
+      const rows = await listAutomotivePartsRequests({ leadId: Number(lead.id), assignedTo: actorId, limit: 1 });
+      if (rows.length) return;
+    }
+    if (legacyRole === "ServiceAdvisor") {
+      const rows = await listAutomotiveServiceBookings({ leadId: Number(lead.id), assignedTo: actorId, limit: 1 });
+      if (rows.length) return;
+    }
+    throw new TRPCError({ code: "FORBIDDEN", message: "Lead is outside assigned data scope" });
+  }
+
+  const { resolveTtcrmScopeUserIds } = await import("./services/rbacDataScope");
+  const teamUserIds = new Set(await resolveTtcrmScopeUserIds(actorId, scope) ?? []);
+  if (teamUserIds.has(ownerId) || activeUserIds.some((id: number) => teamUserIds.has(id))) return;
+  throw new TRPCError({ code: "FORBIDDEN", message: "Lead is outside team data scope" });
 }
 
