+export async function resolveEffectiveTtcrmRoleKey(user: { id: number; role?: string | null }): Promise<string> {
+  const fallbackRoleKey = normalizeUserRole(user.role);
+  const db = await getDb();
+  if (!db) return fallbackRoleKey;
+
+  try {
+    const result = await db.execute(sql`
+      SELECT r.role_key AS roleKey
+      FROM ttcrm_rbac_user_roles ur
+      INNER JOIN ttcrm_rbac_roles r ON r.id = ur.role_id
+      WHERE ur.user_id = ${user.id} AND ur.is_primary = 1
+      ORDER BY ur.id DESC
+      LIMIT 1
+    `);
+    const assignedRoleKey = rowsOf(result)[0]?.roleKey;
+    return assignedRoleKey ? String(assignedRoleKey) : fallbackRoleKey;
+  } catch {
+    // Phase 1 migration may not have been applied yet. Preserve legacy role behavior.
+    return fallbackRoleKey;
+  }
+}
