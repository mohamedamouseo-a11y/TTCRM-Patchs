+export async function listTtcrmRbacUsers() {
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database is unavailable" });
+
+  const result = await db.execute(sql`
+    SELECT u.id,
+           u.name,
+           u.email,
+           u.role AS legacyRole,
+           u.teamId,
+           r.role_key AS assignedRoleKey,
+           r.name_ar AS assignedRoleNameAr,
+           r.name_en AS assignedRoleNameEn,
+           r.is_active AS assignedRoleActive
+    FROM users u
+    LEFT JOIN ttcrm_rbac_user_roles ur
+      ON ur.user_id = u.id AND ur.is_primary = 1
+    LEFT JOIN ttcrm_rbac_roles r
+      ON r.id = ur.role_id
+    WHERE u.deletedAt IS NULL
+    ORDER BY u.name ASC, u.email ASC, u.id ASC
+  `);
+
+  return rowsOf(result).map((row) => ({
+    id: Number(row.id),
+    name: row.name ?? null,
+    email: row.email ?? null,
+    teamId: row.teamId == null ? null : Number(row.teamId),
+    legacyRole: normalizeUserRole(row.legacyRole),
+    roleKey: row.assignedRoleKey ? String(row.assignedRoleKey) : normalizeUserRole(row.legacyRole),
+    roleNameAr: row.assignedRoleNameAr ?? null,
+    roleNameEn: row.assignedRoleNameEn ?? null,
+    roleActive: row.assignedRoleKey ? Boolean(row.assignedRoleActive) : true,
+  }));
+}
