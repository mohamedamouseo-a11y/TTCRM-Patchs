+export async function saveTtcrmRbacRole(actorUserId: number, input: TtcrmRoleSaveInput) {
+  if (input.roleKey === "Admin") {
+    throw new TRPCError({ code: "FORBIDDEN", message: "Admin is a protected system role" });
+  }
+
+  const seenModules = new Set<string>();
+  for (const permission of input.permissions) {
+    if (seenModules.has(permission.module)) {
+      throw new TRPCError({ code: "BAD_REQUEST", message: `Duplicate permission module: ${permission.module}` });
+    }
+    seenModules.add(permission.module);
+  }
+
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database is unavailable" });
+
+  return db.transaction(async (tx) => {
+    const existingResult = await tx.execute(sql`
+      SELECT id, role_key AS roleKey, name_ar AS nameAr, name_en AS nameEn,
+             description, is_system AS isSystem, is_active AS isActive
+      FROM ttcrm_rbac_roles
+      WHERE role_key = ${input.roleKey}
+      LIMIT 1
+    `);
+    const before = rowsOf(existingResult)[0] ?? null;
+
+    await tx.execute(sql`
+      INSERT INTO ttcrm_rbac_roles
+        (role_key, name_ar, name_en, description, is_system, is_active, created_by)
+      VALUES
+        (${input.roleKey}, ${input.nameAr ?? null}, ${input.nameEn}, ${input.description ?? null}, 0, 1, ${actorUserId})
+      ON DUPLICATE KEY UPDATE
+        name_ar = VALUES(name_ar),
+        name_en = VALUES(name_en),
+        description = VALUES(description),
+        is_active = 1
+    `);
+
+    const roleResult = await tx.execute(sql`
+      SELECT id, is_system AS isSystem
+      FROM ttcrm_rbac_roles
+      WHERE role_key = ${input.roleKey}
+      LIMIT 1
+    `);
+    const role = rowsOf(roleResult)[0];
+    if (!role) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Role save failed" });
+    const roleId = Number(role.id);
+
+    await tx.execute(sql`DELETE FROM ttcrm_rbac_role_permissions WHERE role_id = ${roleId}`);
+    for (const permission of input.permissions) {
+      await tx.execute(sql`
+        INSERT INTO ttcrm_rbac_role_permissions
+          (role_id, module_key, can_view, can_create, can_edit, can_delete, can_export, can_approve, can_assign, data_scope)
+        VALUES
+          (${roleId}, ${permission.module}, ${Number(permission.view)}, ${Number(permission.create)},
+           ${Number(permission.edit)}, ${Number(permission.delete)}, ${Number(permission.export)},
+           ${Number(permission.approve)}, ${Number(permission.assign)}, ${permission.dataScope})
+      `);
+    }
+
+    await tx.execute(sql`
+      INSERT INTO ttcrm_rbac_audit_log
+        (actor_user_id, action, target_type, target_id, before_json, after_json)
+      VALUES
+        (${actorUserId}, ${before ? "role.update" : "role.create"}, 'role', ${String(roleId)},
+         ${JSON.stringify(before)}, ${JSON.stringify(input)})
+    `);
+
+    return { success: true as const, roleId, roleKey: input.roleKey, isSystem: Boolean(role.isSystem) };
+  });
+}
+
+export async function disableTtcrmRbacRole(actorUserId: number, roleKey: string) {
+  if (roleKey === "Admin") {
+    throw new TRPCError({ code: "FORBIDDEN", message: "Admin is a protected system role" });
+  }
+
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database is unavailable" });
+
+  const roleResult = await db.execute(sql`
+    SELECT id, is_system AS isSystem, is_active AS isActive
+    FROM ttcrm_rbac_roles
+    WHERE role_key = ${roleKey}
+    LIMIT 1
+  `);
+  const role = rowsOf(roleResult)[0];
+  if (!role) throw new TRPCError({ code: "NOT_FOUND", message: "Role not found" });
+  if (Boolean(role.isSystem)) {
+    throw new TRPCError({ code: "FORBIDDEN", message: "System roles cannot be disabled" });
+  }
+
+  await db.transaction(async (tx) => {
+    await tx.execute(sql`UPDATE ttcrm_rbac_roles SET is_active = 0 WHERE id = ${Number(role.id)}`);
+    await tx.execute(sql`
+      INSERT INTO ttcrm_rbac_audit_log (actor_user_id, action, target_type, target_id, before_json)
+      VALUES (${actorUserId}, 'role.delete', 'role', ${String(role.id)}, ${JSON.stringify({ roleKey, isActive: Boolean(role.isActive) })})
+    `);
+  });
+
+  return { success: true as const };
+}
+
+export async function assignTtcrmRbacUserRole(actorUserId: number, userId: number, roleKey: string) {
+  const db = await getDb();
+  if (!db) throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Database is unavailable" });
+
+  return db.transaction(async (tx) => {
+    const userResult = await tx.execute(sql`
+      SELECT id, role
+      FROM users
+      WHERE id = ${userId} AND deletedAt IS NULL AND isActive = 1
+      LIMIT 1
+    `);
+    const user = rowsOf(userResult)[0];
+    if (!user) throw new TRPCError({ code: "NOT_FOUND", message: "User not found" });
+
+    const roleResult = await tx.execute(sql`
+      SELECT id, role_key AS roleKey, is_system AS isSystem
+      FROM ttcrm_rbac_roles
+      WHERE role_key = ${roleKey} AND is_active = 1
+      LIMIT 1
+    `);
+    const role = rowsOf(roleResult)[0];
+    if (!role) throw new TRPCError({ code: "NOT_FOUND", message: "Role not found or disabled" });
+
+    const currentLegacyRole = normalizeUserRole(user.role);
+    if (currentLegacyRole === "Admin" && roleKey !== "Admin") {
+      throw new TRPCError({ code: "FORBIDDEN", message: "Admin assignment is protected during RBAC migration" });
+    }
+
+    await tx.execute(sql`UPDATE ttcrm_rbac_user_roles SET is_primary = 0 WHERE user_id = ${userId}`);
+    await tx.execute(sql`
+      INSERT INTO ttcrm_rbac_user_roles (user_id, role_id, is_primary, assigned_by)
+      VALUES (${userId}, ${Number(role.id)}, 1, ${actorUserId})
+      ON DUPLICATE KEY UPDATE
+        is_primary = 1,
+        assigned_by = VALUES(assigned_by)
+    `);
+
+    // Keep the legacy enum synchronized only for system roles. Custom role keys
+    // intentionally live only in ttcrm_rbac_user_roles because users.role is an enum.
+    if (Boolean(role.isSystem)) {
+      await tx.execute(sql`UPDATE users SET role = ${roleKey} WHERE id = ${userId}`);
+    }
+
+    await tx.execute(sql`
+      INSERT INTO ttcrm_rbac_audit_log (actor_user_id, action, target_type, target_id, before_json, after_json)
+      VALUES (${actorUserId}, 'user.role.assign', 'user', ${String(userId)},
+              ${JSON.stringify({ roleKey: currentLegacyRole })}, ${JSON.stringify({ roleKey })})
+    `);
+
+    return {
+      success: true as const,
+      roleKey,
+      legacyRoleSynced: Boolean(role.isSystem),
+    };
+  });
+}
