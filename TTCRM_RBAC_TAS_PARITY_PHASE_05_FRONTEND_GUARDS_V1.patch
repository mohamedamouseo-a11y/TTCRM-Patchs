+import { useTtcrmRbac } from "@/lib/ttcrmRbac";
+import type { AppPermission } from "@/lib/roles";
+import type { TtcrmRbacAction, TtcrmRbacModule } from "@shared/rbac";
 
 export function usePermission(permission: AppPermission) {
-  const { user } = useAuth();
-  return hasRolePermission(user?.role, permission);
+  const { user, loading: authLoading } = useAuth();
+  const rbac = useTtcrmRbac(Boolean(user) && !authLoading);
+  if (authLoading || rbac.isLoading || rbac.isFetching || rbac.error || !user) return false;
+  return rbac.canLegacy(permission);
 }
 
 export function useAnyPermission(permissions: readonly AppPermission[]) {
-  const { user } = useAuth();
-  return hasAnyRolePermission(user?.role, permissions);
+  const { user, loading: authLoading } = useAuth();
+  const rbac = useTtcrmRbac(Boolean(user) && !authLoading);
+  if (authLoading || rbac.isLoading || rbac.isFetching || rbac.error || !user) return false;
+  return permissions.some((permission) => rbac.canLegacy(permission));
+}
+
+export function useRbacPermission(module: TtcrmRbacModule, action: TtcrmRbacAction = "view") {
+  const { user, loading: authLoading } = useAuth();
+  const rbac = useTtcrmRbac(Boolean(user) && !authLoading);
+  if (authLoading || rbac.isLoading || rbac.isFetching || rbac.error || !user) return false;
+  return rbac.can(module, action);
+}
+
+export function useRbacScope(module: TtcrmRbacModule) {
+  const { user, loading: authLoading } = useAuth();
+  const rbac = useTtcrmRbac(Boolean(user) && !authLoading);
+  return {
+    scope: rbac.scope(module),
+    loading: authLoading || rbac.isLoading || rbac.isFetching,
+    error: rbac.error ?? null,
+    ready: Boolean(user) && !authLoading && !rbac.isLoading && !rbac.isFetching && !rbac.error,
+  };
 }
diff --git a/client/src/lib/ttcrmRbac.ts b/client/src/lib/ttcrmRbac.ts
