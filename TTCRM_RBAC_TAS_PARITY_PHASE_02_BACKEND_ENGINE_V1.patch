+import { normalizeUserRole } from "./permissions";
+
+export const TTCRM_RBAC_MODULES = [
+  "dashboard",
+  "inbox",
+  "chat",
+  "sales",
+  "marketing",
+  "email_marketing",
+  "accounts",
+  "finance",
+  "business_development",
+  "whatsapp",
+  "import",
+  "trash",
+  "audit_log",
+  "settings",
+  "users",
+  "support",
+] as const;
+
+export const TTCRM_RBAC_ACTIONS = [
+  "view",
+  "create",
+  "edit",
+  "delete",
+  "export",
+  "approve",
+  "assign",
+] as const;
+
+export const TTCRM_DATA_SCOPES = ["own", "assigned", "team", "branch", "all"] as const;
+
+export type TtcrmRbacModule = (typeof TTCRM_RBAC_MODULES)[number];
+export type TtcrmRbacAction = (typeof TTCRM_RBAC_ACTIONS)[number];
+export type TtcrmDataScope = (typeof TTCRM_DATA_SCOPES)[number];
+
+export type TtcrmPermissionGrant = Record<TtcrmRbacAction, boolean> & {
+  dataScope: TtcrmDataScope;
+};
+
+export type TtcrmPermissionMatrix = Partial<Record<TtcrmRbacModule, TtcrmPermissionGrant>>;
+
+export const grant = (
+  actions: Partial<Record<TtcrmRbacAction, boolean>>,
+  dataScope: TtcrmDataScope = "own",
+): TtcrmPermissionGrant => ({
+  view: false,
+  create: false,
+  edit: false,
+  delete: false,
+  export: false,
+  approve: false,
+  assign: false,
+  ...actions,
+  dataScope,
+});
+
+const full = (dataScope: TtcrmDataScope = "all") =>
+  grant({ view: true, create: true, edit: true, delete: true, export: true, approve: true, assign: true }, dataScope);
+
+const read = (dataScope: TtcrmDataScope = "own") => grant({ view: true }, dataScope);
+const engage = (dataScope: TtcrmDataScope = "assigned") => grant({ view: true, edit: true }, dataScope);
+const work = (dataScope: TtcrmDataScope = "assigned") => grant({ view: true, create: true, edit: true }, dataScope);
+
+export const DEFAULT_TTCRM_ROLE_MATRIX: Record<string, TtcrmPermissionMatrix> = {
+  Admin: Object.fromEntries(TTCRM_RBAC_MODULES.map((module) => [module, full("all")])) as TtcrmPermissionMatrix,
+  SalesManager: {
+    dashboard: read("team"),
+    inbox: engage("team"), chat: engage("team"), sales: full("team"),
+    marketing: full("all"), email_marketing: full("all"),
+    accounts: grant({ view: true, create: true, edit: true, assign: true }, "team"),
+    finance: read("team"), whatsapp: full("team"), settings: read("all"), users: read("team"), support: read("all"),
+  },
+  SalesAgent: {
+    dashboard: read("own"), inbox: engage("assigned"), chat: engage("assigned"),
+    sales: work("assigned"), whatsapp: engage("assigned"), support: read("own"),
+  },
+  SalesFinanceAccounting: {
+    dashboard: read("own"), inbox: engage("assigned"), chat: engage("assigned"),
+    sales: work("assigned"), finance: grant({ view: true, edit: true }, "all"),
+    accounts: work("assigned"), whatsapp: engage("assigned"), support: read("own"),
+  },
+  AccountManager: {
+    dashboard: read("own"), chat: engage("assigned"), accounts: work("assigned"),
+    whatsapp: engage("assigned"), support: read("own"),
+  },
+  AccountManagerLead: {
+    dashboard: read("team"), chat: engage("team"),
+    accounts: grant({ view: true, create: true, edit: true, delete: true, assign: true }, "team"),
+    sales: grant({ view: true, export: true }, "team"), whatsapp: engage("team"), support: read("team"),
+  },
+  ServiceAdvisor: {
+    dashboard: read("assigned"), inbox: engage("assigned"), chat: engage("assigned"),
+    sales: grant({ view: true, edit: true }, "assigned"), accounts: grant({ view: true, edit: true }, "assigned"),
+    whatsapp: engage("assigned"), settings: read("all"), support: read("own"),
+  },
+  PartsAgent: {
+    dashboard: read("assigned"), inbox: engage("assigned"), chat: engage("assigned"),
+    sales: grant({ view: true, edit: true }, "assigned"), accounts: grant({ view: true, edit: true }, "assigned"),
+    whatsapp: engage("assigned"), settings: read("all"), support: read("own"),
+  },
+  CrmFollowUp: {
+    dashboard: read("assigned"), inbox: engage("assigned"), chat: engage("assigned"),
+    sales: grant({ view: true, edit: true }, "assigned"), accounts: grant({ view: true, edit: true }, "assigned"),
+    whatsapp: engage("assigned"), settings: read("all"), support: read("own"),
+  },
+  Viewer: {
+    dashboard: read("all"), chat: read("all"), sales: grant({ view: true, export: true }, "all"), support: read("all"),
+  },
+  MediaBuyer: {
+    dashboard: read("all"), inbox: read("all"), chat: engage("all"), sales: read("all"),
+    marketing: full("all"), settings: read("all"), support: read("all"),
+  },
+  BusinessDeveloper: {
+    business_development: full("assigned"), email_marketing: full("all"), finance: read("all"), support: read("own"),
+  },
+};
+
+export function getDefaultTtcrmRoleMatrix(role?: string | null): TtcrmPermissionMatrix {
+  const normalized = normalizeUserRole(role);
+  return DEFAULT_TTCRM_ROLE_MATRIX[normalized] ?? {};
+}
+
+export function canFromTtcrmMatrix(
+  matrix: TtcrmPermissionMatrix,
+  module: TtcrmRbacModule,
+  action: TtcrmRbacAction,
+): boolean {
+  return Boolean(matrix[module]?.[action]);
+}
+
+export function scopeFromTtcrmMatrix(matrix: TtcrmPermissionMatrix, module: TtcrmRbacModule): TtcrmDataScope {
+  return matrix[module]?.dataScope ?? "own";
+}
