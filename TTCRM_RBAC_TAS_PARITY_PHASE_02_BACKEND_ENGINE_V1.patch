+import { protectedProcedure, router } from "./_core/trpc";
+import { normalizeUserRole } from "../shared/permissions";
+import { TTCRM_DATA_SCOPES, TTCRM_RBAC_ACTIONS, TTCRM_RBAC_MODULES } from "../shared/rbac";
+import { getEffectiveTtcrmPermissions } from "./services/rbacService";
+
+export const rbacRouter = router({
+  catalog: protectedProcedure.query(() => ({
+    modules: TTCRM_RBAC_MODULES,
+    actions: TTCRM_RBAC_ACTIONS,
+    dataScopes: TTCRM_DATA_SCOPES,
+  })),
+
+  me: protectedProcedure.query(async ({ ctx }) => ({
+    role: normalizeUserRole(ctx.user.role),
+    permissions: await getEffectiveTtcrmPermissions({
+      id: ctx.user.id,
+      role: ctx.user.role,
+    }),
+  })),
+});
