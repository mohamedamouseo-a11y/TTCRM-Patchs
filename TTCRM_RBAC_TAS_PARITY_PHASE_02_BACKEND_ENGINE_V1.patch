new file mode 100644
--- /dev/null
+++ b/server/services/rbacService.ts
@@ -0,0 +1,126 @@
+import { TRPCError } from "@trpc/server";
+import { sql } from "drizzle-orm";
+import { getDb } from "../db";
+import { normalizeUserRole } from "../../shared/permissions";
+import {
+  DEFAULT_TTCRM_ROLE_MATRIX,
+  TTCRM_DATA_SCOPES,
+  TTCRM_RBAC_MODULES,
+  canFromTtcrmMatrix,
+  scopeFromTtcrmMatrix,
+  type TtcrmDataScope,
+  type TtcrmPermissionMatrix,
+  type TtcrmRbacAction,
+  type TtcrmRbacModule,
+} from "../../shared/rbac";
+
+let warnedSchemaUnavailable = false;
+
+function isKnownModule(value: unknown): value is TtcrmRbacModule {
+  return TTCRM_RBAC_MODULES.includes(String(value) as TtcrmRbacModule);
+}
+
+function isKnownScope(value: unknown): value is TtcrmDataScope {
+  return TTCRM_DATA_SCOPES.includes(String(value) as TtcrmDataScope);
+}
+
+function defaultMatrixForRole(roleKey: string): TtcrmPermissionMatrix {
+  return DEFAULT_TTCRM_ROLE_MATRIX[roleKey] ?? {};
+}
+
+export async function getExplicitTtcrmRoleMatrix(roleKey: string): Promise<TtcrmPermissionMatrix | null> {
+  const db = await getDb();
+  if (!db) return null;
+
+  try {
+    const roleResult = await db.execute(sql`
+      SELECT id, is_system AS isSystem
+      FROM ttcrm_rbac_roles
+      WHERE role_key = ${roleKey} AND is_active = 1
+      LIMIT 1
+    `);
+    const role = (((roleResult as any)[0] ?? []) as any[])[0];
+    if (!role) return null;
+
+    const permissionsResult = await db.execute(sql`
+      SELECT module_key AS moduleKey,
+             can_view AS canView,
+             can_create AS canCreate,
+             can_edit AS canEdit,
+             can_delete AS canDelete,
+             can_export AS canExport,
+             can_approve AS canApprove,
+             can_assign AS canAssign,
+             data_scope AS dataScope
+      FROM ttcrm_rbac_role_permissions
+      WHERE role_id = ${Number(role.id)}
+    `);
+    const rows = ((permissionsResult as any)[0] ?? []) as any[];
+
+    // Phase 1 seeds system roles but intentionally does not seed permission rows.
+    // Until a system role is explicitly configured, preserve the legacy/default matrix.
+    if (!rows.length) return Number(role.isSystem) === 1 ? null : {};
+
+    const matrix: TtcrmPermissionMatrix = {};
+    for (const row of rows) {
+      if (!isKnownModule(row.moduleKey)) continue;
+      matrix[row.moduleKey] = {
+        view: Boolean(row.canView),
+        create: Boolean(row.canCreate),
+        edit: Boolean(row.canEdit),
+        delete: Boolean(row.canDelete),
+        export: Boolean(row.canExport),
+        approve: Boolean(row.canApprove),
+        assign: Boolean(row.canAssign),
+        dataScope: isKnownScope(row.dataScope) ? row.dataScope : "own",
+      };
+    }
+    return matrix;
+  } catch (error) {
+    if (!warnedSchemaUnavailable) {
+      warnedSchemaUnavailable = true;
+      console.warn("[RBAC] Dynamic RBAC schema unavailable; using safe default matrices", error);
+    }
+    return null;
+  }
+}
+
+export async function getEffectiveTtcrmPermissions(user: { id: number; role?: string | null }): Promise<TtcrmPermissionMatrix> {
+  const roleKey = normalizeUserRole(user.role);
+  if (roleKey === "Admin") return DEFAULT_TTCRM_ROLE_MATRIX.Admin;
+
+  const explicit = await getExplicitTtcrmRoleMatrix(roleKey);
+  if (explicit !== null) return explicit;
+  return defaultMatrixForRole(roleKey);
+}
+
+export async function hasEffectiveTtcrmPermission(
+  user: { id: number; role?: string | null },
+  module: TtcrmRbacModule,
+  action: TtcrmRbacAction,
+): Promise<boolean> {
+  const matrix = await getEffectiveTtcrmPermissions(user);
+  return canFromTtcrmMatrix(matrix, module, action);
+}
+
+export async function requireEffectiveTtcrmPermission(
+  user: { id: number; role?: string | null },
+  module: TtcrmRbacModule,
+  action: TtcrmRbacAction,
+): Promise<TtcrmDataScope> {
+  const matrix = await getEffectiveTtcrmPermissions(user);
+  if (!canFromTtcrmMatrix(matrix, module, action)) {
+    throw new TRPCError({ code: "FORBIDDEN", message: `Missing permission: ${module}.${action}` });
+  }
+  return scopeFromTtcrmMatrix(matrix, module);
+}
