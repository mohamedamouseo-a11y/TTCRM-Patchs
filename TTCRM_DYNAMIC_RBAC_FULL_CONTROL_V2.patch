diff --git a/server/services/rolePermissionsService.ts b/server/services/rolePermissionsService.ts
--- a/server/services/rolePermissionsService.ts
+++ b/server/services/rolePermissionsService.ts
@@ -157,3 +157,97 @@ export async function getRolePermissionMatrix() {
     allPermissions: [...APP_PERMISSIONS],
   };
 }
+
+type ProcedureType = "query" | "mutation" | "subscription";
+
+function hasAction(path: string, actions: readonly string[]) {
+  const normalized = path.toLowerCase();
+  return actions.some((action) => normalized.includes(action.toLowerCase()));
+}
+
+/**
+ * Coarse RBAC gate for old protectedProcedure endpoints.
+ * More specific permissionProcedure guards still run afterwards.
+ */
+export function getRequiredPermissionForProcedure(path: string, type: ProcedureType): AppPermission | null {
+  const root = String(path || "").split(".")[0];
+  const isMutation = type === "mutation";
+
+  if (root === "salesReports") return "sales.reports";
+  if (root === "leadDistribution") return isMutation ? "sales.assign" : "sales.view";
+
+  if (["leads", "activities", "deals", "campaigns", "pipelineStages", "customFields", "sales", "calendar"].includes(root)) {
+    if (!isMutation) return "sales.view";
+    if (hasAction(path, ["delete", "remove", "permanentdelete"])) return "sales.delete";
+    if (hasAction(path, ["assign", "transfer", "distribution", "handover"])) return "sales.assign";
+    if (hasAction(path, ["create", "add", "bulkcreate", "import"])) return "sales.create";
+    return "sales.edit";
