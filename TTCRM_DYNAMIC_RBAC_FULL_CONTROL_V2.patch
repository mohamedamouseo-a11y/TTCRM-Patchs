+  }
+
+  if (root === "auditLogs") return isMutation ? "audit.manage" : "audit.view";
+  if (["users", "teams"].includes(root)) return isMutation ? "users.manage" : "users.view";
+  if (root === "support") return "support.view";
+
+  if (["settings", "authIntegrations", "dynamicServices", "googleDriveFileStorage", "backupCenter", "notifications"].includes(root)) {
+    return isMutation ? "settings.manage" : "settings.view";
+  }
+
+  return null;
+}

