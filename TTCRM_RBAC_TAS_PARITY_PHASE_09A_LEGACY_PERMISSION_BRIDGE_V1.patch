+
+async function authorizeLegacyPermission(
+  user: { id: number; role?: string | null },
+  permission: AppPermission,
+  rawInput: unknown,
+): Promise<void> {
+  const target = LEGACY_PERMISSION_RBAC_MAP[permission];
+  if (!target) {
+    throw new TRPCError({ code: "FORBIDDEN", message: `Unmapped legacy permission: ${permission}` });
+  }
+  const dataScope = await requireEffectiveTtcrmPermission(user, target.module, target.action);
+  await enforceTtcrmRequestScope(user.id, dataScope, rawInput);
+}
